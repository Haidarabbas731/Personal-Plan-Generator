# Copy this file to .env and fill in the keys you have.
# At least one is required; the app only shows providers whose key is set.

# https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Password that unlocks the app. Required: the app stays locked without it.
APP_PASSWORD=...
