# Environment variables for docker-compose.dokploy.yml.
#
# Set these in the Dokploy project's "Environment" tab. Do NOT commit a real
# .env.dokploy file. Keep values free of # $ " ' ` \ and spaces: env-file
# parsers cut or rewrite those.

# Password that unlocks the app. Required: the app stays locked without it.
APP_PASSWORD=change-me-to-a-strong-password

# https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# https://openrouter.ai/keys
OPENROUTER_API_KEY=
